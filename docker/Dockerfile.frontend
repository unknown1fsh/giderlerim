FROM node:20-alpine AS build

WORKDIR /repo

COPY package.json package-lock.json .npmrc ./
COPY frontend/package.json ./frontend/package.json
COPY mobile/package.json ./mobile/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN npm ci

COPY frontend ./frontend
COPY packages/shared ./packages/shared
ARG BACKEND_INTERNAL_URL=http://backend:8081
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
RUN npm run build --workspace giderlerim-web

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV BACKEND_INTERNAL_URL=http://backend:8081

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=build /repo/frontend/.next/standalone ./
COPY --from=build /repo/frontend/.next/static ./frontend/.next/static
COPY --from=build /repo/frontend/public ./frontend/public

USER appuser
EXPOSE 3000

CMD ["node", "frontend/server.js"]
